{
  "name": "LumiCast",
  "identifier": "lumicast",
  "version": "0.11.0",
  "author": "fidgetycarrot",
  "github": "https://github.com/fidgetycarrot/lumicast",
  "homepage": "https://github.com/fidgetycarrot/lumicast#readme",
  "description": "Turn character descriptions, typed or from [ooc] replies, into Anima prompts with verified booru tags, and save them to a Cast lorebook.",
  "permissions": [
    "generation",
    "cors_proxy",
    "chats",
    "chat_mutation",
    "characters",
    "world_books"
  ],
  "entry_backend": "dist/backend.js",
  "entry_frontend": "dist/frontend.js",
  "minimum_lumiverse_version": "1.2.5"
}
